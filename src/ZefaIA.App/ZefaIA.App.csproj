<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ZefaIA.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- The tray icon uses WinForms NotifyIcon; WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required by [LibraryImport] source generator (P/Invoke in TrayIconController.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZefaIA.App.Tests" />
    <InternalsVisibleTo Include="ZefaIA.Integration.Tests" />
    <!-- UseWPF/UseWindowsForms replace the default implicit-using set, which drops System.IO. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZefaIA.Audio\ZefaIA.Audio.csproj" />
    <ProjectReference Include="..\ZefaIA.STT\ZefaIA.STT.csproj" />
    <ProjectReference Include="..\ZefaIA.LLM\ZefaIA.LLM.csproj" />
    <ProjectReference Include="..\ZefaIA.Overlay\ZefaIA.Overlay.csproj" />
    <ProjectReference Include="..\ZefaIA.Persistence\ZefaIA.Persistence.csproj" />
  </ItemGroup>
</Project>
