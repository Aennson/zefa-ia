{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Audio": {
    "BufferSizeMs": 100,
    "SampleRate": 16000,
    "Channels": 1
  },
  "STT": {
    "ActiveProvider": "WhisperLocal",
    "WhisperLocal": {
      "ModelSize": "base",
      "Language": "auto",
      "UseGPU": false,
      "ModelPath": "./models"
    },
    "ElevenLabs": {
      "ApiKeyEnvVar": "ELEVENLABS_API_KEY",
      "Language": "auto",
      "VadEnabled": true
    }
  },
  "_LLM_comment": "NOT BOUND YET - MeetingOrchestrator builds LLMSessionConfig from its record defaults, so editing the values below has no effect. Kept in sync with ZefaIA.Core/Models/LLMModels.cs until the binding is wired. See docs/tests/E2E-COVERAGE.md.",
  "LLM": {
    "ModelId": "claude-sonnet-5",
    "MaxTokens": 1024,
    "ApiKeyEnvVar": "ANTHROPIC_API_KEY"
  },
  "Overlay": {
    "Opacity": 0.85,
    "FontSize": 14,
    "Position": "BottomRight",
    "AutoHideSeconds": 30
  },
  "Triggers": {
    "SilenceThresholdMs": 1500,
    "CooldownMs": 10000,
    "MaxRequestsPerMinute": 4,
    "TranscriptWindowSeconds": 60
  }
}
