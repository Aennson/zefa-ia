<Window x:Class="ZefaIA.Overlay.MeetingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zefa IA - Historico de Reunioes"
        Width="900" Height="620"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ZefaIA.Overlay;component/Themes/ZefaTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cada reuniao vira um card selecionavel na coluna da esquerda. -->
            <Style x:Key="SessionItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" CornerRadius="10" Padding="14,11"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="bd" Property="Background" Value="#231F3A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgLayerBrush}" CornerRadius="16"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}"
                                   FontSize="20" Foreground="White" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Historico" Style="{StaticResource H1}" />
                        <TextBlock Text="Transcricoes e sugestoes das reunioes anteriores"
                                   Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="BtnClose_Click" ToolTip="Fechar" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="230" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- Lista -->
                <DockPanel Grid.Column="0">
                    <TextBox x:Name="TxtSearch" DockPanel.Dock="Top"
                             Style="{StaticResource AppTextBox}" Margin="0,0,0,14"
                             TextChanged="TxtSearch_TextChanged"
                             ToolTip="Busca por titulo, agenda ou conteudo da transcricao" />

                    <Button x:Name="BtnDelete" DockPanel.Dock="Bottom"
                            Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                            Click="BtnDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{StaticResource DangerBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Deletar" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnExportTxt" Grid.Column="0" Margin="0,0,5,0"
                                Style="{StaticResource SecondaryButton}" Content="TXT"
                                Click="BtnExportTxt_Click" ToolTip="Exportar como texto" />
                        <Button x:Name="BtnExportJson" Grid.Column="1" Margin="5,0,0,0"
                                Style="{StaticResource SecondaryButton}" Content="JSON"
                                Click="BtnExportJson_Click" ToolTip="Exportar como JSON" />
                    </Grid>

                    <ListBox x:Name="LstSessions"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SessionItem}"
                             SelectionChanged="LstSessions_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DateDisplay}" FontSize="12" Margin="0,3,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

                <!-- Detalhe -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock x:Name="TxtDetailHeader" DockPanel.Dock="Top"
                                   Style="{StaticResource H2}" Text="Selecione uma reuniao"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtDetailMeta" DockPanel.Dock="Top"
                                   Style="{StaticResource Caption}" Margin="0,4,0,14"
                                   TextWrapping="Wrap" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PnlDetail" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
