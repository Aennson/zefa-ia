<Window x:Class="ZefaIA.Overlay.MeetingHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zefa IA - Historico de Reunioes"
        Width="700" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinWidth="500" MinHeight="400">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Session List -->
        <DockPanel Grid.Column="0">
            <TextBlock Text="Reunioes" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top"/>

            <TextBox x:Name="TxtSearch" DockPanel.Dock="Top"
                     Height="28" Margin="0,0,0,8" Padding="4,2"
                     TextChanged="TxtSearch_TextChanged"/>

            <Button x:Name="BtnDelete" Content="Deletar" DockPanel.Dock="Bottom"
                    Height="28" Margin="0,8,0,0"
                    Background="#DC2626" Foreground="White"
                    Click="BtnDelete_Click"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="BtnExportTxt" Content="Exportar TXT"
                        Width="115" Height="28" Margin="0,0,6,0"
                        Background="#2D2D44" Foreground="#CCFFFFFF"
                        Click="BtnExportTxt_Click"/>
                <Button x:Name="BtnExportJson" Content="Exportar JSON"
                        Width="115" Height="28"
                        Background="#2D2D44" Foreground="#CCFFFFFF"
                        Click="BtnExportJson_Click"/>
            </StackPanel>

            <ListBox x:Name="LstSessions"
                     Background="#12122A" Foreground="#CCFFFFFF"
                     BorderBrush="#333355"
                     SelectionChanged="LstSessions_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E0E0FF"/>
                            <TextBlock Text="{Binding DateDisplay}" FontSize="11" Foreground="#8888AA"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" Background="#333355"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Detail Panel -->
        <DockPanel Grid.Column="2">
            <TextBlock x:Name="TxtDetailHeader" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top"
                       Text="Selecione uma reuniao"/>
            <TextBlock x:Name="TxtDetailMeta" DockPanel.Dock="Top"
                       Foreground="#8888AA" FontSize="11" Margin="0,0,0,8"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlDetail"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
