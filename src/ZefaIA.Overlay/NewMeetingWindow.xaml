<Window x:Class="ZefaIA.Overlay.NewMeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zefa IA - Nova Reuniao"
        Width="460" Height="440"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="TextBox" x:Key="FieldTextBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button" x:Key="TemplateButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#2D2D44"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#444466"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Nova Reuniao" Style="{StaticResource SectionHeader}" FontSize="18"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Titulo (opcional)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtTitle" Style="{StaticResource FieldTextBox}"/>

            <TextBlock Text="Template" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                <Button Content="1:1" Style="{StaticResource TemplateButton}" Click="BtnTemplate_Click" Tag="0"/>
                <Button Content="Standup" Style="{StaticResource TemplateButton}" Click="BtnTemplate_Click" Tag="1"/>
                <Button Content="Review" Style="{StaticResource TemplateButton}" Click="BtnTemplate_Click" Tag="2"/>
                <Button Content="Custom" Style="{StaticResource TemplateButton}" Click="BtnTemplate_Click" Tag="3"/>
            </StackPanel>

            <TextBlock Text="Agenda / Contexto" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtAgenda" Height="60" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Margin="0,2,0,6"/>

            <TextBlock Text="Objetivo" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtObjective" Style="{StaticResource FieldTextBox}"/>

            <TextBlock Text="Participantes" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtParticipants" Style="{StaticResource FieldTextBox}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="32" Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="Inicio Rapido" Width="100" Height="32" Margin="0,0,8,0"
                    Background="#2D2D44" Foreground="#CCFFFFFF"
                    Click="BtnQuickStart_Click"/>
            <Button Content="Iniciar Reuniao" Width="120" Height="32"
                    Background="#7C3AED" Foreground="White"
                    Click="BtnStart_Click"/>
        </StackPanel>
    </Grid>
</Window>
