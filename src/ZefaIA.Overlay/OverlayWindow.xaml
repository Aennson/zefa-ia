<Window x:Class="ZefaIA.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        Width="440" Height="380"
        MinWidth="300" MinHeight="200"
        MaxWidth="1000" MaxHeight="900"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ZefaIA.Overlay;component/Themes/ZefaTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Botao de icone compacto para a barra do overlay. -->
            <Style x:Key="OverlayIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Aba: mesma linguagem dos chips da tela de nova reuniao. -->
            <Style x:Key="OverlayTab" TargetType="RadioButton">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="{StaticResource BgBaseBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CornerPill}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource BgLayerBrush}" CornerRadius="16"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de titulo (arrasta a janela) -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Margin="14,10,10,0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="7"
                            Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="&#xE720;" Style="{StaticResource Glyph}"
                                   FontSize="11" Foreground="White" />
                    </Border>
                    <TextBlock Text="Zefa IA" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPin" Style="{StaticResource OverlayIconButton}"
                            Content="&#xE718;" Opacity="0.6" ToolTip="Fixar (impede o auto-ocultar)"
                            Click="BtnPin_Click" />
                    <Button x:Name="BtnCopy" Style="{StaticResource OverlayIconButton}"
                            Content="&#xE8C8;" ToolTip="Copiar o conteudo da aba atual"
                            Click="BtnCopy_Click" />
                    <Button x:Name="BtnDismiss" Style="{StaticResource OverlayIconButton}"
                            Content="&#xE711;" ToolTip="Ocultar"
                            Click="BtnDismiss_Click" />
                </StackPanel>
            </Grid>

            <!-- Abas -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,12,14,0">
                <RadioButton x:Name="TabTranscription" Style="{StaticResource OverlayTab}"
                             Content="Transcricao" IsChecked="True" Checked="Tab_Checked" />
                <RadioButton x:Name="TabSuggestions" Style="{StaticResource OverlayTab}"
                             Content="Sugestoes" Checked="Tab_Checked" />
            </StackPanel>

            <!--
                Alca de redimensionamento: a borda arrastavel existe nos quatro lados
                (ver OnWindowMessage), mas sem uma marca visivel ninguem descobre que da
                para redimensionar uma janela sem moldura.
            -->
            <Path Grid.Row="2" Width="12" Height="12" Margin="0,0,6,6"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                  IsHitTestVisible="False" Panel.ZIndex="10"
                  Data="M 11,1 L 1,11 M 11,5 L 5,11 M 11,9 L 9,11" />

            <!-- Conteudo -->
            <Grid Grid.Row="2" Margin="14,12,10,14">
                <ScrollViewer x:Name="TranscriptionScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ItemsControl x:Name="TranscriptionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Timestamp}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SpeakerName}"
                                                   Foreground="{Binding SpeakerColor}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding TextColor}"
                                               FontStyle="{Binding FontStyle}"
                                               FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid x:Name="SuggestionsPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <StackPanel>
                            <StackPanel x:Name="ThinkingIndicator" Orientation="Horizontal"
                                        Margin="2,4,0,8" Visibility="Collapsed">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                         Fill="{StaticResource AccentBrush}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.2" Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="Pensando..." Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border x:Name="CurrentSuggestionBorder" CornerRadius="10"
                                    Background="#231F3A" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" Padding="14,11" Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="SUGESTAO" Foreground="{StaticResource AccentBrush}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock x:Name="CurrentSuggestionText"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="SuggestionHistory">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="9"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Padding="12,9" Margin="0,0,0,7">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Timestamp}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
