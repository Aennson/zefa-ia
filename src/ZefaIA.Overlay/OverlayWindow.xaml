<Window x:Class="ZefaIA.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        Width="420" Height="360"
        MinWidth="300" MinHeight="200"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#DD1A1A2E" CornerRadius="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar with controls -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="#22FFFFFF"
                    CornerRadius="12,12,0,0" Padding="8,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Zefa IA"
                               Foreground="#CCFFFFFF" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="4,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,2,0">
                        <Button x:Name="BtnPin" Style="{StaticResource ControlButton}"
                                Content="&#x1F4CC;" ToolTip="Fixar"
                                Click="BtnPin_Click"/>
                        <Button x:Name="BtnCopy" Style="{StaticResource ControlButton}"
                                Content="&#x1F4CB;" ToolTip="Copiar"
                                Click="BtnCopy_Click"/>
                        <Button x:Name="BtnDismiss" Style="{StaticResource ControlButton}"
                                Content="&#x2715;" ToolTip="Ocultar"
                                Click="BtnDismiss_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tab bar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,0">
                <RadioButton x:Name="TabTranscription" Style="{StaticResource TabButton}"
                             Content="Transcricao" IsChecked="True"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSuggestions" Style="{StaticResource TabButton}"
                             Content="Sugestoes"
                             Checked="Tab_Checked"/>
            </StackPanel>

            <!-- Content area -->
            <Grid Grid.Row="2" Margin="8,4,8,8">
                <!-- Transcription panel -->
                <ScrollViewer x:Name="TranscriptionScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ItemsControl x:Name="TranscriptionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Timestamp}"
                                                   Foreground="#66FFFFFF" FontSize="10" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SpeakerName}"
                                                   Foreground="{Binding SpeakerColor}" FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding TextColor}"
                                               FontStyle="{Binding FontStyle}"
                                               FontSize="13" TextWrapping="Wrap"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Suggestions panel -->
                <Grid x:Name="SuggestionsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <StackPanel>
                            <!-- Thinking indicator -->
                            <StackPanel x:Name="ThinkingIndicator" Orientation="Horizontal"
                                        Margin="0,8" Visibility="Collapsed">
                                <Ellipse Width="6" Height="6" Fill="#7C3AED" Margin="0,0,4,0"/>
                                <TextBlock Text="Pensando..." Foreground="#7C3AED"
                                           FontSize="12" FontStyle="Italic"/>
                            </StackPanel>

                            <!-- Current suggestion -->
                            <Border x:Name="CurrentSuggestionBorder"
                                    Background="#15A78BFA" CornerRadius="8"
                                    Padding="12,8" Margin="0,4"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Sugestao" Foreground="#A78BFA"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="CurrentSuggestionText"
                                               Foreground="#EEEEFF" FontSize="13"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Suggestion history -->
                            <ItemsControl x:Name="SuggestionHistory">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0AFFFFFF" CornerRadius="6"
                                                Padding="10,6" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Timestamp}"
                                                           Foreground="#55FFFFFF" FontSize="10"/>
                                                <TextBlock Text="{Binding Text}"
                                                           Foreground="#AAFFFFFF" FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
