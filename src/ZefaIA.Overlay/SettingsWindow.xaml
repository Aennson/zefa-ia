<Window x:Class="ZefaIA.Overlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zefa IA - Configuracoes"
        Width="580"
        MinHeight="600" MaxHeight="860"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ZefaIA.Overlay;component/Themes/ZefaTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgLayerBrush}" CornerRadius="16"
            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"
                                   FontSize="20" Foreground="White" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Configuracoes" Style="{StaticResource H1}" />
                        <TextBlock Text="Aplicado na proxima reuniao, exceto o overlay"
                                   Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="BtnCancel_Click" ToolTip="Fechar" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>

                    <TextBlock Text="TRANSCRICAO" Style="{StaticResource SectionHeader}" Margin="0,12,0,2" />

                    <TextBlock Text="PROVEDOR" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <ComboBox x:Name="CmbProvider" Style="{StaticResource AppComboBox}"
                              ItemContainerStyle="{StaticResource AppComboItem}">
                        <ComboBoxItem Content="Whisper Local" />
                        <ComboBoxItem Content="ElevenLabs" />
                    </ComboBox>

                    <TextBlock Text="MODELO WHISPER" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbModelSize" Style="{StaticResource AppComboBox}"
                              ItemContainerStyle="{StaticResource AppComboItem}">
                        <ComboBoxItem Content="tiny" />
                        <ComboBoxItem Content="base" />
                        <ComboBoxItem Content="small" />
                        <ComboBoxItem Content="medium" />
                    </ComboBox>

                    <TextBlock Text="IDIOMA" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbLanguage" Style="{StaticResource AppComboBox}"
                              ItemContainerStyle="{StaticResource AppComboItem}">
                        <ComboBoxItem Content="auto" />
                        <ComboBoxItem Content="pt" />
                        <ComboBoxItem Content="en" />
                        <ComboBoxItem Content="es" />
                        <ComboBoxItem Content="fr" />
                    </ComboBox>

                    <CheckBox x:Name="ChkGpu" Content="Usar GPU (CUDA)"
                              Style="{StaticResource AppCheckBox}" Margin="2,18,0,0" />

                    <TextBlock Text="CHAVES DE API" Style="{StaticResource SectionHeader}" />

                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,0"
                               Text="Guardadas criptografadas nesta conta do Windows. Deixe em branco para usar a variavel de ambiente." />

                    <Grid Margin="0,14,0,6">
                        <TextBlock Text="ANTHROPIC (SUGESTOES)" Style="{StaticResource FieldLabel}"
                                   Margin="2,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LblAnthropicSource" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <PasswordBox x:Name="PwdAnthropic" Style="{StaticResource AppPasswordBox}" />
                        <TextBox x:Name="TxtAnthropic" Style="{StaticResource AppTextBox}"
                                 Margin="0" Visibility="Collapsed" />
                    </Grid>

                    <Grid Margin="0,14,0,6">
                        <TextBlock Text="ELEVENLABS (TRANSCRICAO)" Style="{StaticResource FieldLabel}"
                                   Margin="2,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LblElevenLabsSource" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <PasswordBox x:Name="PwdElevenLabs" Style="{StaticResource AppPasswordBox}" />
                        <TextBox x:Name="TxtElevenLabs" Style="{StaticResource AppTextBox}"
                                 Margin="0" Visibility="Collapsed" />
                    </Grid>

                    <!--
                        Colunas, nao sobreposicao: o AppCheckBox usa um StackPanel de fundo
                        transparente que ocupa toda a largura disponivel e engoliria os
                        cliques do botao ao lado.
                    -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="ChkRevealKeys" Grid.Column="0" Content="Mostrar chaves"
                                  Style="{StaticResource AppCheckBox}" Margin="2,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Checked="RevealKeys_Changed" Unchecked="RevealKeys_Changed" />
                        <Button x:Name="BtnTestKeys" Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="Testar chaves" Width="140" Height="34"
                                Click="BtnTestKeys_Click" />
                    </Grid>

                    <TextBlock x:Name="LblKeyTestResult" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="2,10,0,0" Visibility="Collapsed" />

                    <TextBlock Text="PERFIL" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="NOME" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <TextBox x:Name="TxtName" Style="{StaticResource AppTextBox}" />

                    <TextBlock Text="CARGO / FUNCAO" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtRole" Style="{StaticResource AppTextBox}" />

                    <TextBlock Text="AREA DE EXPERTISE" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtExpertise" Style="{StaticResource AppTextBox}" />

                    <TextBlock Text="TOM PREFERIDO" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbTone" Style="{StaticResource AppComboBox}"
                              ItemContainerStyle="{StaticResource AppComboItem}">
                        <ComboBoxItem Content="Formal" />
                        <ComboBoxItem Content="Casual" />
                        <ComboBoxItem Content="Tecnico" />
                    </ComboBox>

                    <TextBlock Text="CONTEXTO ADICIONAL" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtContext" Style="{StaticResource AppTextBox}"
                             Height="86" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="14,10"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="ATALHOS" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="PEDIR SUGESTAO" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <TextBox x:Name="TxtHotkeySuggestion" Style="{StaticResource AppTextBox}"
                             Text="Ctrl+Shift+Space" IsReadOnly="True"
                             ToolTip="Pede uma sugestao imediatamente, sem depender de silencio" />

                    <TextBlock Text="MOSTRAR / OCULTAR OVERLAY" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtHotkeyToggle" Style="{StaticResource AppTextBox}"
                             Text="Ctrl+Shift+Z" IsReadOnly="True" />

                    <TextBlock Text="COPIAR ULTIMA SUGESTAO" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtHotkeyCopy" Style="{StaticResource AppTextBox}"
                             Text="Ctrl+Shift+C" IsReadOnly="True" />

                    <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="OPACIDADE" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <Slider x:Name="SldOpacity" Style="{StaticResource AppSlider}"
                            Minimum="0.3" Maximum="1.0" Value="0.85"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" />

                    <TextBlock Text="TAMANHO DA FONTE" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="SldFontSize" Style="{StaticResource AppSlider}"
                            Minimum="10" Maximum="24" Value="14"
                            TickFrequency="1" IsSnapToTickEnabled="True" />

                    <TextBlock Text="POSICAO" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbPosition" Style="{StaticResource AppComboBox}"
                              ItemContainerStyle="{StaticResource AppComboItem}">
                        <ComboBoxItem Content="Inferior Direito" />
                        <ComboBoxItem Content="Inferior Esquerdo" />
                        <ComboBoxItem Content="Superior Direito" />
                        <ComboBoxItem Content="Superior Esquerdo" />
                        <ComboBoxItem Content="Centro" />
                    </ComboBox>

                    <TextBlock Text="AUTO-OCULTAR (SEGUNDOS, 0 = NUNCA)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtAutoHide" Style="{StaticResource AppTextBox}" Text="30" />

                    <CheckBox x:Name="ChkExcludeCapture" Content="Ocultar de captura de tela"
                              Style="{StaticResource AppCheckBox}" IsChecked="True" Margin="2,18,0,0"
                              ToolTip="Invisivel em compartilhamento de tela e prints" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                        HorizontalAlignment="Left" Width="120" Click="BtnCancel_Click" />

                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Width="150"
                        Click="BtnSave_Click" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Salvar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
