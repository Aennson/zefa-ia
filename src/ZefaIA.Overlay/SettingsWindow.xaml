<Window x:Class="ZefaIA.Overlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zefa IA - Configuracoes"
        Width="480" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#A78BFA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="SettingsCombo">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style TargetType="TextBox" x:Key="SettingsTextBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="CheckBox" x:Key="SettingsCheck">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- STT Provider -->
                <TextBlock Text="Provedor de STT" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Provedor ativo" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbProvider" Style="{StaticResource SettingsCombo}">
                    <ComboBoxItem Content="Whisper Local"/>
                    <ComboBoxItem Content="ElevenLabs"/>
                </ComboBox>

                <TextBlock Text="Modelo Whisper" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbModelSize" Style="{StaticResource SettingsCombo}">
                    <ComboBoxItem Content="tiny"/>
                    <ComboBoxItem Content="base"/>
                    <ComboBoxItem Content="small"/>
                    <ComboBoxItem Content="medium"/>
                </ComboBox>

                <TextBlock Text="Idioma" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbLanguage" Style="{StaticResource SettingsCombo}">
                    <ComboBoxItem Content="auto"/>
                    <ComboBoxItem Content="pt"/>
                    <ComboBoxItem Content="en"/>
                    <ComboBoxItem Content="es"/>
                    <ComboBoxItem Content="fr"/>
                </ComboBox>

                <CheckBox x:Name="ChkGpu" Content="Usar GPU (CUDA)" Style="{StaticResource SettingsCheck}"/>

                <!-- Profile -->
                <TextBlock Text="Perfil do Usuario" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Nome" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource SettingsTextBox}"/>

                <TextBlock Text="Cargo / Funcao" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtRole" Style="{StaticResource SettingsTextBox}"/>

                <TextBlock Text="Area de expertise" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtExpertise" Style="{StaticResource SettingsTextBox}"/>

                <TextBlock Text="Tom preferido" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbTone" Style="{StaticResource SettingsCombo}">
                    <ComboBoxItem Content="Formal"/>
                    <ComboBoxItem Content="Casual"/>
                    <ComboBoxItem Content="Tecnico"/>
                </ComboBox>

                <TextBlock Text="Contexto adicional" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtContext" Height="60" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Margin="0,2,0,6"/>

                <!-- Hotkeys -->
                <TextBlock Text="Atalhos" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Pedir sugestao" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtHotkeySuggestion" Style="{StaticResource SettingsTextBox}"
                         Text="Ctrl+Shift+Space" IsReadOnly="True"/>

                <TextBlock Text="Toggle overlay" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtHotkeyToggle" Style="{StaticResource SettingsTextBox}"
                         Text="Ctrl+Shift+Z" IsReadOnly="True"/>

                <TextBlock Text="Copiar ultima sugestao" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtHotkeyCopy" Style="{StaticResource SettingsTextBox}"
                         Text="Ctrl+Shift+C" IsReadOnly="True"/>

                <!-- Overlay -->
                <TextBlock Text="Overlay" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Opacidade" Style="{StaticResource FieldLabel}"/>
                <Slider x:Name="SldOpacity" Minimum="0.3" Maximum="1.0" Value="0.85"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                        Margin="0,2,0,6"/>

                <TextBlock Text="Tamanho da fonte" Style="{StaticResource FieldLabel}"/>
                <Slider x:Name="SldFontSize" Minimum="10" Maximum="24" Value="14"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Margin="0,2,0,6"/>

                <TextBlock Text="Posicao" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbPosition" Style="{StaticResource SettingsCombo}">
                    <ComboBoxItem Content="Inferior Direito"/>
                    <ComboBoxItem Content="Inferior Esquerdo"/>
                    <ComboBoxItem Content="Superior Direito"/>
                    <ComboBoxItem Content="Superior Esquerdo"/>
                    <ComboBoxItem Content="Centro"/>
                </ComboBox>

                <TextBlock Text="Auto-ocultar (segundos, 0 = nunca)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtAutoHide" Style="{StaticResource SettingsTextBox}" Text="30"/>

                <CheckBox x:Name="ChkExcludeCapture" Content="Ocultar de captura de tela"
                          Style="{StaticResource SettingsCheck}" IsChecked="True"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Width="90" Height="32" Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
            <Button Content="Salvar" Width="90" Height="32"
                    Background="#7C3AED" Foreground="White"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
