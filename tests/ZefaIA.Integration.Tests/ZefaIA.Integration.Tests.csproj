<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseWPF (pulled in transitively by the App/Overlay references) replaces the
         default implicit-using set, which drops these. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZefaIA.Audio\ZefaIA.Audio.csproj" />
    <ProjectReference Include="..\..\src\ZefaIA.STT\ZefaIA.STT.csproj" />
    <ProjectReference Include="..\..\src\ZefaIA.LLM\ZefaIA.LLM.csproj" />
    <ProjectReference Include="..\..\src\ZefaIA.Core\ZefaIA.Core.csproj" />
    <!-- The end-to-end tests drive the real MeetingOrchestrator, so they need the
         whole graph: App wires it, Persistence stores it, Overlay renders it. -->
    <ProjectReference Include="..\..\src\ZefaIA.App\ZefaIA.App.csproj" />
    <ProjectReference Include="..\..\src\ZefaIA.Persistence\ZefaIA.Persistence.csproj" />
    <ProjectReference Include="..\..\src\ZefaIA.Overlay\ZefaIA.Overlay.csproj" />
  </ItemGroup>
</Project>
